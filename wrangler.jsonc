{
  "name": "ccgrondal-site",
  "compatibility_date": "2026-07-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "./worker/index.js",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    },
    "redact_query_string": true
  },
  "preview_urls": false
}
